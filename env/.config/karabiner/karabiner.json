            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock: tap = Escape, hold = hyper layer (Karabiner variable, no modifiers sent to apps) | Hyper+hjkl = arrows, Hyper+e = word right, Hyper+w = control+w (nvim window prefix), Hyper+q = control+q (nvim quickfix), Hyper+b = tmux prefix, Hyper+c = control+c, Hyper+o/i = control+o/control+i (nvim jumplist back/forward), Hyper+d/u = control+d/control+u (page down/up), Hyper+a then o/s/m/t = apps (opera/slack/mail/iterm)",
                        "manipulators": [
