#!/usr/bin/env bash
real_run="0"

XDG_CONFIG_HOME=$HOME/.config
DEV_ENV=$HOME/codebase/personal/dev-env

# Config directories that also hold live state we don't track. These get an
# overlay copy instead of rm+copy, so files the app writes itself survive.
# karabiner: Karabiner-Elements owns automatic_backups/ and assets/.
PRESERVE_DIRS="karabiner"

if [[ $1 == "--real" ]]; then
    real_run="1"
fi

log() {
    if [[ $real_run == "1" ]]; then
        echo "$1"
    else
        echo "[DRY_RUN]: $1"
    fi
}

is_preserved() {
    for p in $PRESERVE_DIRS; do
        if [[ $1 == $p ]]; then
            return 0
        fi
    done
    return 1
}

log "env: $DEV_ENV"

update_files() {
    log "copying over files from: $1"
    pushd $1 &> /dev/null
    (
        configs=`find . -mindepth 1 -maxdepth 1 -type d`
        for c in $configs; do
            name=${c#./}
            directory=${2%/}/$name

            if is_preserved $name; then
                log "    preserving live state, overlay only: $directory"
            else
                log "    removing: rm -rf $directory"

                if [[ $real_run == "1" ]]; then
                    rm -rf $directory
                fi
            fi

            log "    copying env: cp $c $2"
            if [[ $real_run == "1" ]]; then
                cp -r ./$c $2
            fi
        done

    )
    popd &> /dev/null
}

copy() {
    log "removing: $2"
    if [[ $real_run == "1" ]]; then
        rm $2
    fi
    log "copying: $1 to $2"
    if [[ $real_run == "1" ]]; then
        cp $1 $2
    fi
}

update_files $DEV_ENV/env/.config $XDG_CONFIG_HOME

# Get those config files into ~/
copy $DEV_ENV/env/.zshrc $HOME/.zshrc
copy $DEV_ENV/env/.p10k.zsh $HOME/.p10k.zsh
copy $DEV_ENV/env/.tmux.conf $HOME/.tmux.conf
