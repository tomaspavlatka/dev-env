#!/usr/bin/env bash

# Friday digital detox: clears ~/Desktop, ~/Downloads and ~/Documents.
#
# Per folder it collects everything into a dated staging folder --
# desktop-saturday-20260912/ -- and trashes that single folder, so the Trash
# shows you where each pile came from. Nothing is deleted outright: it goes
# through Finder, so the folder keeps its "Put Back" entry and drops straight
# home again if you change your mind.
#
#   ./dev-detox                   # dry run, lists what would be trashed
#   ./dev-detox --real            # actually trash it
#   ./dev-detox downloads --real  # limit to one folder
#
# Hidden files (.DS_Store, .localized, ...) are never touched.
# Add glob patterns to KEEP below to protect files you always want to survive.

script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd)"

TARGETS=(Desktop Downloads Documents)
KEEP=()   # e.g. KEEP=("taxes*" "*.kdbx")

real_run="0"
only=""
stamp="$(date +%Y%m%d)"
# LC_ALL=C so the name stays English regardless of system locale.
weekday="$(LC_ALL=C date +%A | tr 'A-Z' 'a-z')"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --real) real_run="1" ;;
        -h|--help)
            sed -n '3,16p' "$script_dir/dev-detox" | sed 's/^# \{0,1\}//'
            exit 0 ;;
        -*)     echo "unknown flag: $1"; exit 1 ;;
        *)      only="$1" ;;
    esac
    shift
done

log() {
    if [[ $real_run == "1" ]]; then
        echo "$1"
    else
        echo "[DRY_RUN]: $1"
    fi
}

keep_match() {
    local name="$1" pat
    for pat in "${KEEP[@]}"; do
        [[ -n "$pat" && "$name" == $pat ]] && return 0
    done
    return 1
}

# Hands paths to Finder so they land in the Trash with Put Back info intact.
to_trash() {
    osascript - "$@" >/dev/null <<'APPLESCRIPT'
on run argv
    set trashList to {}
    repeat with p in argv
        set end of trashList to (POSIX file (p as text)) as alias
    end repeat
    tell application "Finder" to delete trashList
end run
APPLESCRIPT
}

if [[ -n "$only" ]]; then
    matched=""
    for t in "${TARGETS[@]}"; do
        if [[ "$(echo "$t" | tr 'A-Z' 'a-z')" == "$(echo "$only" | tr 'A-Z' 'a-z')" ]]; then
            matched="$t"
        fi
    done
    if [[ -z "$matched" ]]; then
        echo "unknown folder: $only (expected one of: ${TARGETS[*]})"
        exit 1
    fi
    TARGETS=("$matched")
fi

log "DETOX: ${TARGETS[*]}"

total=0
for t in "${TARGETS[@]}"; do
    dir="$HOME/$t"

    if [[ ! -d "$dir" ]]; then
        log "  $t -- no such folder, skipping"
        continue
    fi

    paths=()
    while IFS= read -r -d '' path; do
        name="$(basename "$path")"
        if keep_match "$name"; then
            log "    keep   $name"
            continue
        fi
        paths+=("$path")
    done < <(find "$dir" -mindepth 1 -maxdepth 1 ! -name '.*' -print0 2>/dev/null)

    if [[ ${#paths[@]} -eq 0 ]]; then
        log "  $t -- already clean"
        continue
    fi

    # One dated folder per source, so the Trash says where the pile came from.
    slug="$(echo "$t" | tr 'A-Z' 'a-z')-$weekday-$stamp"
    stage_name="$slug"
    n=2
    while [[ -e "$dir/$stage_name" ]]; do
        stage_name="$slug-$n"
        n=$((n + 1))
    done
    stage="$dir/$stage_name"

    log "  $t -- ${#paths[@]} item(s) -> $stage_name/"
    for path in "${paths[@]}"; do
        log "      $(basename "$path")  ($(du -sh "$path" 2>/dev/null | cut -f1 | tr -d ' '))"
    done

    if [[ $real_run != "1" ]]; then
        total=$((total + ${#paths[@]}))
        continue
    fi

    if ! mkdir "$stage"; then
        echo "  !! could not create $stage"
        exit 1
    fi

    for path in "${paths[@]}"; do
        if ! mv "$path" "$stage/"; then
            echo "  !! could not move $(basename "$path") into $stage_name/"
            echo "     Anything already moved is sitting in that folder, on your $t."
            exit 1
        fi
    done

    if to_trash "$stage"; then
        total=$((total + ${#paths[@]}))
    else
        echo "  !! Finder refused to trash $stage_name"
        echo "     Your files are safe in $stage -- trash that folder by hand."
        echo "     Grant the terminal Automation access to Finder:"
        echo "     System Settings > Privacy & Security > Automation"
        exit 1
    fi
done

log "DONE: $total item(s) moved to Trash"
if [[ $real_run != "1" ]]; then
    echo "Nothing was touched. Re-run with --real to do it."
fi
